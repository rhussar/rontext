# Copy to .env.local. These three are the only values the app needs to boot;
# every integration key is entered later in Settings → Connections.

# Neon (or any Postgres) connection string. `vercel env pull` fills this in
# when the Neon Marketplace integration is attached to your Vercel project.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The passcode you sign in with.
APP_PASSCODE="choose-a-passcode"

# Any long random string, e.g. `openssl rand -hex 32`. Signs the session cookie.
SESSION_SECRET="replace-with-64-hex-chars"

# --- optional -------------------------------------------------------------
# Only for running the public demo locally (scripts/dev-demo.sh, seed-demo.ts):
# a separate database named rontext_demo. Never point this at real data.
# DEMO_DATABASE_URL="postgresql://user:password@host/rontext_demo?sslmode=require"
